{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccesoDeLaAppAlBucketDeImagenes",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<NOMBRE_DEL_BUCKET>/*"
    },
    {
      "Sid": "ListarElBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<NOMBRE_DEL_BUCKET>"
    }
  ]
}
