{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerInstancias",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IniciarYDetenerSoloEstaInstancia",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-2:*:instance/i-080caf245240b78e3"
    }
  ]
}
