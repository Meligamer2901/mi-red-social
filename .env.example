# ==========================================================
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).
# ==========================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# URL publica del backend (usada para construir enlaces a imagenes locales)
BASE_URL=http://localhost:4000
# Origen(es) permitido(s) para CORS. En produccion usa el dominio real (ej: https://miredsocial.com)
CORS_ORIGIN=*

# --- Base de datos relacional (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mi_red_social
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# --- Autenticacion JWT ---
# Genera una cadena aleatoria larga, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_en_produccion

# --- Google Login (OAuth 2.0) ---
# Crear en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# --- reCAPTCHA v2 ("No soy un robot") ---
# Crear en https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key

# --- Almacenamiento de imagenes ---
# STORAGE_DRIVER = local | s3
# "local": las imagenes se guardan en disco bajo ./imagenes (modo desarrollo, no requiere AWS)
# "s3":    las imagenes se guardan en un bucket de Amazon S3 (modo produccion en AWS)
STORAGE_DRIVER=local

# --- AWS (solo necesario si STORAGE_DRIVER=s3 o si usas Rekognition) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=mi-red-social-imagenes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Amazon Rekognition (opcional, analisis avanzado de imagenes) ---
REKOGNITION_ENABLED=false
